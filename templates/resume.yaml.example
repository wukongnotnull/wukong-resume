# ============================================
# wukong-resume 简历模板示例
# ============================================
# 使用说明：
# 1. 复制此文件并命名为 resume.yaml
# 2. 填写你的信息
# 3. 删除不需要的可选字段（或设为 []）
# ============================================

meta:
  # 必填：语言选择
  language: zh           # zh（中文）或 en（英文）
  
  # 必填：模板选择
  template: single       # single（单栏）或 sidebar（双栏）
  
  # 必填：风格选择
  style: tech            # tech | creative | business | finance | academic | literary | custom
  
  # 必填：纸张大小
  page_size: A4          # A4（默认中文）或 Letter（默认英文）
  
  # 必填（至少填一个）：姓名
  name_zh: 张三
  name_en: Zhang San

# ============================================
# 基本信息
# ============================================
basics:
  # 必填：职位定位（一句话）
  headline: 高级前端工程师
  
  # 可选：照片（相对路径，如 assets/photo.jpg）
  photo: assets/photo.jpg
  
  # 可选：出生年月（用于计算年龄）
  birthdate: 1995-06
  
  # 可选（仅中文简历显示）：国内字段
  gender: 男
  political_status: 群众
  hometown: 北京
  marital_status: 未婚
  
  # 可选：所在地
  location: 上海
  
  # 必填（至少填一个）：联系方式
  email: zhangsan@example.com
  phone: "+86 138-0000-0000"
  website: https://zhangsan.dev
  github: github.com/zhangsan
  linkedin: linkedin.com/in/zhangsan
  
  # 可选：个人简介（2-4句）
  summary: |
    5年前端开发经验，擅长 React、TypeScript、性能优化。
    曾主导重构电商平台，首屏加载时间从 3.2s 降至 1.1s。
    热爱开源，GitHub 累计 5k+ stars。

# ============================================
# 工作经历（必填，最新的放前面）
# ============================================
experience:
  - company: 字节跳动
    role: 高级前端工程师
    start: 2022-03
    end: 至今
    location: 北京
    highlights:
      - 主导电商平台前端重构，首屏加载时间从 3.2s 优化至 1.1s
      - 搭建组件库，覆盖 10+ 业务线，提效 40%
      - 推动团队规范建设，建立代码审查流程和技术文档

  - company: 阿里巴巴
    role: 前端开发工程师
    start: 2020-07
    end: 2022-02
    location: 杭州
    highlights:
      - 负责商家中心后台系统开发，日均 PV 100万+
      - 优化移动端体验，用户留存率提升 15%
      - 参与双11大促技术保障，零故障

# ============================================
# 教育背景（必填）
# ============================================
education:
  - school: 清华大学
    degree: 计算机科学与技术 硕士
    start: 2018-09
    end: 2020-06
    gpa: 3.8/4.0
    highlights:
      - 优秀毕业生
      - 国家奖学金

  - school: 北京大学
    degree: 软件工程 学士
    start: 2014-09
    end: 2018-06
    gpa: 3.7/4.0

# ============================================
# 技能（必填，按分类）
# ============================================
skills:
  - category: 前端技术
    items:
      - React
      - TypeScript
      - Vue 3
      - Webpack
      - Vite
      - Tailwind CSS
  - category: 后端/工具
    items:
      - Node.js
      - Python
      - MySQL
      - Redis
      - Docker
      - Git
  - category: 其他
    items:
      - 性能优化
      - 组件设计
      - 工程化

# ============================================
# 可选部分（没有可留空 []）
# ============================================
projects:
  - name: Web Components 组件库
    url: github.com/zhangsan/ui-components
    description: 轻量级 Web Components 组件库
    highlights:
      - GitHub 2.3k stars
      - 已在 5 个项目中使用
      - 支持 Tree Shaking，体积减少 40%

  - name: 个人博客系统
    url: zhangsan.dev
    description: 基于 Next.js 的个人技术博客
    highlights:
      - 累计访问量 10万+
      - SEO 优化，百度搜索关键词前 3

awards:
  - title: 字节跳动技术之星
    issuer: 字节跳动
    date: 2023-06

  - title: 阿里云天池大赛一等奖
    issuer: 阿里云
    date: 2021-10

certifications:
  - name: AWS Solutions Architect - Associate
    issuer: Amazon Web Services
    date: 2022-08

  - name: Google Cloud Professional Cloud Developer
    issuer: Google Cloud
    date: 2022-05

languages:
  - 英语（流利，CET-6 600+）
  - 日语（N3）
